# Copy to .env (or set in your hosting dashboard). All values are optional.

# HTTP port. Hosting platforms usually set this for you.
PORT=4000

# Public base URL printed into permit QR codes, e.g. https://zeroasphyx.onrender.com
# If unset: Render/Railway URLs are detected automatically; otherwise the address the dashboard was opened from.
PUBLIC_URL=

# MQTT broker and topic prefix. MQTT_PREFIX must equal PREFIX in firmware/sketch.ino.
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_PREFIX=safeentry/TEAMID

# Data source at startup: LIVE (Wokwi over MQTT) or SIM (simulator). Default LIVE.
ZA_MODE=LIVE

# Set to "off" to disable MQTT entirely (simulator only).
# ZA_MQTT=off

# Storage: sqlite (default, falls back to json automatically) or json.
# ZA_STORE=json
# ZA_DATA_DIR=./server/data
